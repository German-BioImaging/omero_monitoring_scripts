#!/bin/bash
token=$(cat ~/.tok_mm)
mmserver="https://SERVER/mm/api/v4/posts"
channelid="CHANNEL_ID"

sql="SELECT to_char(s.started, 'YYYY-MM') period, count(DISTINCT e.omeName) user_count
FROM Session s
INNER JOIN Experimenter AS e ON e.id=s.owner
WHERE s.started > (Now() - '1 week'::interval)
AND to_char(s.started, 'YYYY-MM') = to_char(Now()- '5 day'::interval, 'YYYY-MM')
GROUP BY to_char(s.started, 'YYYY-MM');"

raw_res="Number of single user over the last week:\\n\`\`\`\\n"$(psql omero -U report_user -h 127.0.0.1 -c "$sql" | sed -E ':a;N;$!ba;s/\r{0,1}\n/\\n/g')"\\n\`\`\`"

curl -i -X POST -H 'Content-Type: text/plain' -d '{"channel_id":"'"$channelid"'", "message":"'"$raw_res"'"}' -H 'Authorization: Bearer '"$token" "$mmserver"
